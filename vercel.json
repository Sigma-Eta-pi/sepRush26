{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "/api"
    },
    {
      "source": "/authorize",
      "destination": "/api"
    },
    {
      "source": "/token",
      "destination": "/api"
    },
    {
      "source": "/register",
      "destination": "/api"
    },
    {
      "source": "/revoke",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ucsbsep.com"
        }
      ],
      "destination": "https://www.ucsbsep.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ucsbsep.com"
        }
      ],
      "destination": "https://www.ucsbsep.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ucsbsep.org"
        }
      ],
      "destination": "https://www.ucsbsep.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ucsbsep.org"
        }
      ],
      "destination": "https://www.ucsbsep.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.ucsbsep.org"
        }
      ],
      "destination": "https://www.ucsbsep.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ucsbsep.org"
        }
      ],
      "destination": "https://www.ucsbsep.com/:path*",
      "permanent": true
    }
  ]
}
