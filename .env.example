# Existing Neon database connection. Keep this secret; never put it in VITE_* variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Public Google OAuth Web client ID. No client secret is needed for this GIS flow.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Canonical production origin, no trailing slash. Redirect other chapter domains here.
APP_ORIGIN=https://www.ucsbsep.com
# For local Google testing use APP_ORIGIN=http://localhost:3000 with pnpm dev.
API_PORT=3456

# Enable the authenticated MCP integration only after production login is configured.
MCP_ENABLED=false

# Incoming Google Voice email relay. Disabled until a real message is verified.
SMS_ENABLED=false
SMS_GMAIL_ADDRESS=chapter-account@gmail.com
SMS_VOICE_NUMBER=+18055550123
# Generate a random 32-byte hex secret locally; share only with chapter-owned Apps Script properties.
SMS_RELAY_SECRET=
ANTHROPIC_API_KEY=
SMS_DAILY_AI_LIMIT=100

# Production defaults to database-backed private member media.
MEMBER_IMPORT_STORAGE=database
# Local import source for the offline publish:directory validation/migration only.
# MEMBER_IMPORT_DIR=.private/member-import
